// Package model holds the storm models: the database types. Only the data
// package imports them.
package model

import "github.com/gsoultan/storm"

// Note is the notes table.
type Note struct {
	storm.Model // id uuid, created_at, updated_at

	Title string
	Body  string
}

func (n *Note) Schema(t *storm.Table) {
	t.Col(&n.Title).Size(200)
}
